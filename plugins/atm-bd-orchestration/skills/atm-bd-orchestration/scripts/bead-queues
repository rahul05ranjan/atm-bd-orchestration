#!/usr/bin/env python3
"""Display one phase's current ATM BD console snapshot.

Usage: bead-queues --phase <phase>

This command is deliberately a viewer, not an orchestration loop.  The
console owns reading the snapshot, judging staleness, and rendering it; this
wrapper simply preserves the console's output and status.
"""
from __future__ import annotations

import argparse
import shutil
import subprocess
import sys


FAILED = 2
CONSOLE = "atm-bd-console"
CONSOLE_INSTALL = (
    "uv tool install "
    "git+https://github.com/randlee/atm-bd-orchestration.git#subdirectory=apps/atm-bd-console"
)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="bead-queues", description=__doc__)
    parser.add_argument("--phase", required=True, help="phase to display")
    args = parser.parse_args(argv)

    console = shutil.which(CONSOLE)
    if console is None:
        print(f"bead-queues: {CONSOLE} is not on PATH; install it with: {CONSOLE_INSTALL}", file=sys.stderr)
        return FAILED

    completed = subprocess.run([console, "show", "--phase", args.phase])
    return completed.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
